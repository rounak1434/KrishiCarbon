# =================================================================
# FarmerChoice Backend Production Environment Variables (.env.example)
# =================================================================

# Server port (Render will inject PORT automatically, fallback 5000)
PORT=5000

# Environment mode: development | production | test
NODE_ENV=production

# Supabase or hosted PostgreSQL database connection string
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# JWT configuration
JWT_SECRET="replace_with_a_secure_random_secret_at_least_32_characters"
JWT_EXPIRES_IN="7d"

# Allowed CORS origins (comma-separated, e.g. https://krishicarbon-frontend.onrender.com)
CORS_ORIGIN="https://krishicarbon-frontend.onrender.com"

# Optional AI API Key (e.g. Gemini / OpenAI for document extraction)
AI_API_KEY=""

# Document Storage Provider: "local" (for dev) or "cloudinary" (for production)
STORAGE_PROVIDER="cloudinary"

# Local Storage Path (only used when STORAGE_PROVIDER="local")
STORAGE_PATH="./uploads"

# Cloudinary Configuration (Required when STORAGE_PROVIDER="cloudinary")
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="krishicarbon_documents"

# Optional: Full Cloudinary URL alternative
# CLOUDINARY_URL="cloudinary://[api_key]:[api_secret]@[cloud_name]"
