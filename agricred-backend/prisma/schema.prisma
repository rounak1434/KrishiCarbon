generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FARMER
  ADMIN
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  VERIFIED
  REVIEW_REQUIRED
  REJECTED
}

enum DocumentType {
  LAND_DOCUMENT
  SOIL_REPORT
  CROP_RECORD
  IRRIGATION_RECORD
  FERTILIZER_RECORD
  PRACTICE_PHOTO
  OTHER
}

enum AssessmentStatus {
  DRAFT
  COMPLETED
}

enum RecommendationPriority {
  LOW
  MEDIUM
  HIGH
}

enum FertilizerCategory {
  ORGANIC
  SYNTHETIC
  INTEGRATED
}

enum OrganicFertilizerType {
  COMPOST
  FARMYARD_MANURE
  VERMICOMPOST
  BIOFERTILIZER
  GREEN_MANURE
  OTHER
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(FARMER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  farmer       Farmer?
  auditLogs    AuditLog[]

  @@index([email])
}

model Farmer {
  id        String   @id @default(uuid())
  userId    String   @unique
  name      String
  phone     String
  state     String
  district  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  farms     Farm[]

  @@index([userId])
}

model Farm {
  id                    String                 @id @default(uuid())
  farmerId              String
  name                  String
  areaAcres             Float
  soilType              String
  irrigationMethod      String
  waterSource           String
  fertilizerUsage       String                 @default("NOT_SPECIFIED")
  fertilizerCategory    FertilizerCategory?
  organicFertilizerType OrganicFertilizerType?
  pesticideUsage        String
  tillageMethod         String
  residueManagement     String
  organicPractices      Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  farmer                Farmer                 @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  crops                 CropHistory[]
  documents             Document[]
  assessments           Assessment[]

  @@index([farmerId])
}

model CropHistory {
  id        String   @id @default(uuid())
  farmId    String
  crop      String
  season    String
  year      Int
  yield     Float
  createdAt DateTime @default(now())

  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
}

model Document {
  id            String         @id @default(uuid())
  farmId        String
  type          DocumentType
  filename      String
  storageUrl    String
  mimeType      String
  fileSize      Int
  status        DocumentStatus @default(UPLOADED)
  extractedData Json?
  uploadedBy    String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  farm          Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@index([type])
  @@index([status])
}

model Assessment {
  id             String                    @id @default(uuid())
  farmId         String
  overallScore   Float
  readinessLevel String                    // HIGH_READINESS, MODERATE_READINESS, NEEDS_IMPROVEMENT
  status         AssessmentStatus          @default(COMPLETED)
  engineVersion  String                    @default("1.0.0")
  summary        Json?
  createdAt      DateTime                  @default(now())

  farm           Farm                      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  categoryScores AssessmentCategoryScore[]
  recommendations Recommendation[]

  @@index([farmId])
  @@index([createdAt])
}

model AssessmentCategoryScore {
  id           String     @id @default(uuid())
  assessmentId String
  category     String
  score        Float
  weight       Float      @default(1.0)

  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

model Recommendation {
  id           String                 @id @default(uuid())
  assessmentId String
  category     String
  priority     RecommendationPriority @default(MEDIUM)
  message      String
  completed    Boolean                @default(false)
  createdAt    DateTime               @default(now())

  assessment   Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
